# Copy this file to .env and fill in real values. Only variables prefixed
# with VITE_ are exposed to client-side code (see src/vite-env.d.ts).

# Web3Forms Access Key — https://web3forms.com (free account, no backend).
# Create one, connect info@hneineh.com as the destination inbox, and paste
# the key it gives you below. This key is public-by-design (Web3Forms is
# built to have it ship in client code), not a secret to protect.
VITE_WEB3FORMS_ACCESS_KEY=

# Add future backend/API config here as it comes up, e.g.:
# VITE_API_BASE_URL=
